{
  "name": "oira666_pi-web-search",
  "version": "0.0.3",
  "description": "Provider-native web search for pi across Google Gemini, OpenAI, and Anthropic, plus Gemini URL Context",
  "type": "module",
  "main": "src/index.ts",
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "web-search",
    "gemini",
    "google",
    "openai",
    "anthropic",
    "url-context",
    "url-analysis",
    "youtube"
  ],
  "author": "oira666",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gee666/pi-web-search.git"
  },
  "bugs": {
    "url": "https://github.com/gee666/pi-web-search/issues"
  },
  "homepage": "https://github.com/gee666/pi-web-search#readme",
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "test:e2e": "node --test tests/*.e2e.mjs",
    "test:integration": "node --test tests/*.integration.mjs",
    "test:evergreen": "npm test && npm run check && npm run test:integration && npm run test:e2e",
    "test:real:web-search": "node tests/real-web-search.mjs",
    "test:real:url-context": "node tests/real-url-context.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^26.6.5",
    "typebox": "^1.4.3",
    "typescript": "^7.0.2"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
